[Unit]
Description=Coding Plan Usage Monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/coding-plan-usage
ExecStart=/srv/coding-plan-usage/coding-plan-usage run --config /srv/coding-plan-usage/config.yaml
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
